#!/usr/bin/env bash
set -eu

LIST=(
  jsx.jp
  www.jsx.jp
  mqtt.jsx.jp
  20250705.jsx.jp
  cdn.jsx.jp
  chat-mqtt-cool.cdn.jsx.jp
  clock.cdn.jsx.jp
  doom.cdn.jsx.jp
  fake.cdn.jsx.jp
  lineage.cdn.jsx.jp
  maintenance.cdn.jsx.jp
  mqtt.cdn.jsx.jp
  paycard.cdn.jsx.jp
  site.cdn.jsx.jp
  snow.cdn.jsx.jp
  tetris.cdn.jsx.jp
  timer.cdn.jsx.jp
  todo.cdn.jsx.jp
  todo-vue.cdn.jsx.jp
  totp.cdn.jsx.jp
  s.jsx.jp
)

get_dn_value() {
  local issuer="$1"
  local field="$2"
  local value

  value=$(printf '%s\n' "$issuer" | sed -n "s/.*${field}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p")
  if [ -z "$value" ]; then
    value=$(printf '%s\n' "$issuer" | sed -n "s/.*${field}[[:space:]]*=[[:space:]]*\([^,]*\).*/\1/p")
  fi
  printf '%s' "$(printf '%s' "$value" | sed 's/^ *//; s/ *$//')"
}

ssl() {
  DOMAIN=$1
  printf "SSL check %26s  " $DOMAIN

  # get certificate expiration date
  NOT_AFTER=$(echo | openssl s_client -connect "$DOMAIN":443 -servername "$DOMAIN" 2>/dev/null | openssl x509 -noout -enddate | cut -d= -f2)
  if [ -z "$NOT_AFTER" ]; then
    echo -e "\e[31m[ERROR] failed to get certificate\e[0m"
    return 1
  fi
  EXPIRES=$(TZ=Asia/Tokyo date -Iseconds -d "$NOT_AFTER" | sed 's/T/ /' | sed 's/+09/ +09/')

  # convert current time and expiration time to epoch seconds (in seconds)
  CURRENT_SEC=$(date +%s)
  EXPIRE_SEC=$(date -d "$EXPIRES" +%s)

  # calculate remaining days
  REMAIN_DAYS=$(( (EXPIRE_SEC - CURRENT_SEC) / 86400 ))

  # display results (red for less than 30 days, green for 30 days or more)
  if [ "$REMAIN_DAYS" -lt 30 ]; then
    echo -e "Expires: $EXPIRES (\e[1;31mat ${REMAIN_DAYS} days\e[0m) ⚠️"
  else
    echo -e "Expires: $EXPIRES (\e[32mat ${REMAIN_DAYS} days\e[0m)"
  fi

  # get certificate chain and display intermediate and root CAs (shown on following lines)
  CERTS=$(echo | openssl s_client -connect "$DOMAIN":443 -servername "$DOMAIN" -showcerts 2>/dev/null)
  if [ -n "$CERTS" ]; then
    TMPDIR=$(mktemp -d)
    echo "$CERTS" | awk -v dir="$TMPDIR" '
      BEGIN { n=0; out="" }
      /-----BEGIN CERTIFICATE-----/ { out = sprintf("%s/cert.%d.pem", dir, ++n); print > out; next }
      /-----END CERTIFICATE-----/ { print >> out; close(out); next }
      { if (out != "") print >> out }
    '

    COUNT=$(ls -1 "$TMPDIR" 2>/dev/null | wc -l || true)
    if [ "$COUNT" -ge 1 ]; then
      # If server sends multiple certs, treat last as root and others as intermediates
      if [ "$COUNT" -gt 1 ]; then
        echo "  Intermediate CAs:"
        for i in $(seq 2 $COUNT); do
          ISSUER=$(openssl x509 -noout -issuer -in "$TMPDIR/cert.$i.pem" | sed 's/^issuer=//')
          OU=$(get_dn_value "$ISSUER" OU)
          if [ -n "$OU" ]; then
            echo "    $OU"
          else
            O=$(get_dn_value "$ISSUER" O)
            if [ -n "$O" ]; then
              echo "    $O"
            else
              CN=$(get_dn_value "$ISSUER" CN)
              if [ -n "$CN" ]; then
                echo "    $CN"
              else
                echo "    (issuer info unavailable)"
              fi
            fi
          fi
        done
      fi
      echo "  Root CA:"
      ISSUER=$(openssl x509 -noout -issuer -in "$TMPDIR/cert.$COUNT.pem" | sed 's/^issuer=//')
      OU=$(get_dn_value "$ISSUER" OU)
      if [ -n "$OU" ]; then
        echo "    $OU"
      else
        O=$(get_dn_value "$ISSUER" O)
        if [ -n "$O" ]; then
          echo "    $O"
        else
          CN=$(get_dn_value "$ISSUER" CN)
          if [ -n "$CN" ]; then
            echo "    $CN"
          else
            echo "    (issuer info unavailable)"
          fi
        fi
      fi
    fi

    rm -rf "$TMPDIR"
  fi
}

main() {
  for i in "${LIST[@]}"; do
    ssl "$i"
  done
}

main
